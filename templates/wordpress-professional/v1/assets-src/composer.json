{
    "name": "struct8/wordpress-professional-tracing",
    "description": "PHP libraries of the tracing of the WordPress Professional template. Exact versions; composer.lock pins the rest.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "~8.3.0",
        "ext-opentelemetry": "*",
        "open-telemetry/api": "1.10.1",
        "open-telemetry/context": "1.5.0",
        "open-telemetry/sdk": "1.15.0",
        "open-telemetry/exporter-otlp": "1.4.0",
        "open-telemetry/sem-conv": "1.44.0",
        "open-telemetry/opentelemetry-auto-wordpress": "0.2.0",
        "php-http/guzzle7-adapter": "1.1.0"
    },
    "config": {
        "optimize-autoloader": true,
        "autoloader-suffix": "Struct8WordpressTracing",
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "php-http/discovery": false,
            "tbachert/spi": false
        },
        "sort-packages": true
    }
}
