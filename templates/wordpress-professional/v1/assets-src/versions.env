# Every version the setup assets are built from. Nothing here moves on its own:
# a tag, a release or a checksum names one build, and the build refuses a
# download whose checksum differs.
#
# The WordPress image of the template's task definition. The PHP extension is
# compiled inside it, so it loads only in a PHP with the same extension API
# (PHP_EXTENSION_DIR ends in it). The task definition on the diagram names the
# same tag and digest.
WORDPRESS_IMAGE=public.ecr.aws/docker/library/wordpress:7.1.5-php8.3-apache@sha256:2e5145737f46b8fd53f333a05eb3a4f21321c90e20475b7827082dd5f75b62b0
PHP_EXTENSION_API=no-debug-non-zts-20230831

# OpenTelemetry PHP extension, from PECL.
OTEL_EXTENSION_VERSION=1.4.2
OTEL_EXTENSION_SHA256=a355329259f373c5c7327e66310481726cfabac50cb5483eba000bec791d5017

# WP-CLI, the release phar.
WP_CLI_VERSION=2.12.0
WP_CLI_SHA256=ce34ddd838f7351d6759068d09793f26755463b4a4610a5a5c0a97b68220d85c

# Composer installs the PHP libraries from composer.lock. It runs only in the
# build; the assets do not carry it.
COMPOSER_VERSION=2.11.2
COMPOSER_SHA256=dd158c0afd41d15fac89e1b4e47b5d42911fe316c3687cd5edac98319b25d028
